generator client {
  provider   = "prisma-client-js"
  engineType = "library"
}

datasource db {
  provider = "postgresql"
}

model Song {
  id         Int        @id @default(autoincrement())
  title      String
  content    String
  key        String
  url_song   String?
  categories Category[]
  categoryId Int?
  author     Author?    @relation(fields: [authorId], references: [id])
  authorId   Int?
  misaSongs  MisaSong[]
  active     Boolean    @default(true)
  userId     Int?
  user       User?      @relation(fields: [userId], references: [id])

  @@map("songs")
}

model Author {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  songs     Song[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("authors")
}

model User {
  id              Int              @id @default(autoincrement())
  name            String
  email           String           @unique
  password        String
  googleId        String?          @unique
  avatarUrl       String?
  role            Role             @relation(fields: [roleId], references: [id])
  roleId          Int
  phoneNumber     String?
  misas           Misa[]
  songs           Song[]
  ministryMembers MinistryMember[]

  @@map("users")
}

model Role {
  id          Int          @id @default(autoincrement())
  name        String       @unique
  users       User[]
  permissions Permission[]

  @@map("roles")
}

model Permission {
  id    Int    @id @default(autoincrement())
  name  String @unique
  roles Role[]

  @@map("permissions")
}

model Category {
  id       Int     @id @default(autoincrement())
  name     String
  songs    Song[]
  isSecret Boolean @default(false)

  @@map("categories")
}

model Misa {
  id          Int          @id @default(autoincrement())
  title       String
  dateCreate  DateTime     @default(now())
  dateMisa    DateTime
  misaSongs   MisaSong[]
  misaMoments MisaMoment[]
  visibility  String       @default("PUBLIC")
  shareToken  String?      @default(uuid())
  editToken   String?      @default(uuid())
  userId      Int?
  user        User?        @relation(fields: [userId], references: [id])
  ministryId  Int?
  ministry    Ministry?    @relation(fields: [ministryId], references: [id])

  @@map("misa")
}

model Moment {
  id          Int          @id @default(autoincrement())
  nombre      String       @unique @db.VarChar(50)
  misaSongs   MisaSong[]
  misaMoments MisaMoment[]

  @@map("moment")
}

model MisaSong {
  id       Int     @id @default(autoincrement())
  misa     Misa    @relation(fields: [misaId], references: [id], onDelete: Cascade)
  misaId   Int
  song     Song    @relation(fields: [songId], references: [id], onDelete: Cascade)
  songId   Int
  moment   Moment? @relation(fields: [momentId], references: [id], onDelete: Cascade)
  momentId Int?
  key      String? @db.VarChar(10)
  order    Int     @default(0)

  @@map("missa_song")
}

model MisaMoment {
  id       Int    @id @default(autoincrement())
  misa     Misa   @relation(fields: [misaId], references: [id], onDelete: Cascade)
  misaId   Int
  moment   Moment @relation(fields: [momentId], references: [id], onDelete: Cascade)
  momentId Int
  order    Int    @default(0)

  @@unique([misaId, momentId])
  @@map("misa_moments")
}

model Ministry {
  id                 Int              @id @default(autoincrement())
  name               String
  description        String?
  avatarUrl          String?
  inviteCode         String           @unique @default(uuid())
  requireApproval    Boolean          @default(false)
  allowMemberInvites Boolean          @default(false)
  foundedAt          DateTime         @default(now())
  active             Boolean          @default(true)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  members            MinistryMember[]
  misas              Misa[]

  @@map("ministries")
}

model MinistryMember {
  id         Int              @id @default(autoincrement())
  ministry   Ministry         @relation(fields: [ministryId], references: [id], onDelete: Cascade)
  ministryId Int
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     Int
  role       MinistryRole     @default(MEMBER)
  status     MembershipStatus @default(ACTIVE)
  joinedAt   DateTime         @default(now())

  @@unique([ministryId, userId])
  @@map("ministry_members")
}

enum MinistryRole {
  ADMIN
  MEMBER
}

enum MembershipStatus {
  ACTIVE
  PENDING
}
