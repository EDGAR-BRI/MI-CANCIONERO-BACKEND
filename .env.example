# Database (Prisma)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# API
PORT=3000
CORS_ORIGIN="http://localhost:4321,http://localhost:4322,http://localhost:4323"
FRONTEND_URL="http://localhost:4321"
IA_API_URL="http://localhost:3001/api"

# Authentication (Native JWT)
JWT_SECRET="YOUR_SUPER_SECRET_JWT_KEY"
JWT_EXPIRES_IN="7d"
REFRESH_TOKEN_COOKIE_DAYS=30

# Google OAuth 2.0 (Direct Integration)
GOOGLE_CLIENT_ID="YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="YOUR_GOOGLE_CLIENT_SECRET"
GOOGLE_REDIRECT_URI="http://localhost:4321/auth/callback"

# Redis - Local (development)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# Redis - Upstash (production) - if set, local Redis is ignored
# UPSTASH_REDIS_REST_URL="https://YOUR_INSTANCE.upstash.io"
# UPSTASH_REDIS_REST_TOKEN="YOUR_TOKEN"